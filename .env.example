# ─────────────────────────────────────────────────────────────
# CBT System — Required Environment Variables
# Copy this file to .env (local) or set these in Render's dashboard (production).
# ─────────────────────────────────────────────────────────────

# Database connection string
# Local dev (SQLite):  file:./prisma/dev.db
# Production (Postgres): provided by Render or your DB host, looks like:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# JWT secret — MUST be at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Frontend URL(s) allowed to call this API (comma-separated if more than one).
# Local dev:  http://localhost:5173
# Production: https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Set to 'production' when deploying live (enables HTTPS redirect + HSTS)
NODE_ENV=development

PORT=5000

# ─────────────────────────────────────────────────────────────
# SAFE EXAM BROWSER (SEB) SETTINGS
# ─────────────────────────────────────────────────────────────

# Master toggle — when "true", exam start/auto-save/submit routes reject
# any request not coming from Safe Exam Browser (checked via User-Agent).
# Leave "false" while developing locally so you can test in a normal browser.
SEB_REQUIRED=false

# Stronger verification — when "true", also requires the cryptographic
# X-SafeExamBrowser-RequestHash header to match. Requires SEB_BROWSER_EXAM_KEY
# below to be set to the SAME value configured in your .seb config file.
# Recommended: leave "false" until you've tested Layer 1 successfully in a
# real SEB session and confirmed the hash matching works in your environment.
SEB_STRICT_MODE=false

# Must match the "Browser Exam Key" set in your .seb configuration file.
# Only required if SEB_STRICT_MODE=true.
SEB_BROWSER_EXAM_KEY=
